generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Dataset {
  id          String   @id @default(uuid())
  title       String
  description String
  isPremium   Boolean  @default(false)
  price       Float?
  sourceType  String
  sourceId    String
  localPath   String?
  status      String?  @default("DRAFT")
  createdAt   DateTime @default(now())

  ownerId String?
  owner   User?   @relation("UserDatasets", fields: [ownerId], references: [id])

  episodes Episode[]
}

model Episode {
  id         String  @id @default(uuid())
  datasetId  String
  dataset    Dataset @relation(fields: [datasetId], references: [id])
  filePath   String?
  data       Json?
  duration   Float
  frameCount Int
}

model Request {
  id        String   @id @default(uuid())
  type      String
  status    String
  payload   String
  email     String
  createdAt DateTime @default(now())
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Custom Relations
  roles               UserRole[]
  teleoperatorProfile TeleoperatorProfile?
  labProfile          LabProfile?
  datasets            Dataset[]            @relation("UserDatasets")
  payments            Payment[]            @relation("UserPayments")
  earningsLedger      EarningsLedger[]     @relation("UserLedger")

  // Existing system needs (optional, can link these later if needed)
  createdAt     DateTime       @default(now())
  notifications Notification[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Data Models
model UserRole {
  id     String @id @default(uuid())
  userId String
  role   String // "teleoperator" | "lab"
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model TeleoperatorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String?
  bio         String?
  skillTags   String? // Store as JSON string or comma separated
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LabProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  orgName   String?
  orgSize   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // e.g., "SUBMISSION_APPROVED", "SUBMISSION_REJECTED"
  message   String
  read      Boolean  @default(false)
  link      String? // Optional link to related resource
  createdAt DateTime @default(now())
}

model Payment {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation("UserPayments", fields: [userId], references: [id])
  role            String   // "lab" | "teleoperator"
  type            String   // "purchase" | "request_funding" | "payout"
  amountCents     Int
  currency        String   @default("USD")
  status          String   // "pending" | "succeeded" | "failed" | "processing" | "paid"
  method          String   // "mock_card" | "mock_ach" | "mock_invoice" | "mock_paypal" | "mock_bank"
  referenceType   String?  // "dataset" | "job_request" | "payout_request"
  referenceId     String?
  transactionId   String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EarningsLedger {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation("UserLedger", fields: [userId], references: [id])
  amountCents     Int
  type            String   // "credit" (earning) | "debit" (payout)
  status          String   @default("completed") // "completed" | "pending_payout" 
  description     String?
  referenceType   String?  // "dataset" | "job_request" | "payout_request"
  referenceId     String?
  createdAt       DateTime @default(now())
}
