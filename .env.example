# ==============================================================================
# Embodex Web Application Environment Variables
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control.
# ==============================================================================

# Database Connection (PostgreSQL - Owned canonically by embodex-web)
# DATABASE_URL: Connection pooled URL (e.g. Supabase connection pooler on port 6543)
DATABASE_URL="postgresql://postgres:password@localhost:5432/embodex?schema=public"
# DIRECT_URL: Direct database connection URL (used by Prisma migrations)
DIRECT_URL="postgresql://postgres:password@localhost:5432/embodex?schema=public"

# NextAuth Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-random-secret-here-with-openssl-rand-hex-32"

# Google OAuth (Optional - for Google Login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Embodex Teleop Backend Service Integration
# CRITICAL: EMBODEX_API_TOKEN and EMBODEX_WS_TICKET_SECRET are server-side ONLY.
# NEVER prefix them with NEXT_PUBLIC_ or expose them to browser JavaScript.
EMBODEX_TELEOP_HTTP_URL="http://localhost:8500"
EMBODEX_API_TOKEN="permanent-service-bearer-token-matching-teleop"
EMBODEX_WS_TICKET_SECRET="shared-ws-ticket-signing-secret-matching-teleop"

# Public Browser WebSocket URL (Credentials are passed via short-lived ticket subprotocol, never in URL)
NEXT_PUBLIC_EMBODEX_TELEOP_WS_URL="ws://localhost:8500/ws"
EMBODEX_TELEOP_RECORDS_PATH="/path/to/embodex-teleop/records"

# Legacy fallbacks (Deprecated in v0.2, planned removal in a future release):
# NEXT_PUBLIC_TELEGRIP_HTTP_URL="http://localhost:8500"
# NEXT_PUBLIC_TELEGRIP_WS_URL="ws://localhost:8500"
# TELEGRIP_RECORDS_PATH="/path/to/embodex-teleop/records"

# Email Delivery (Resend - Optional)
RESEND_API_KEY=""
SMTP_FROM="noreply@embodex.org"

# reCAPTCHA / Bot Protection (Optional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
GOOGLE_CLOUD_PROJECT_ID=""
